{
    "name": "phaenon/debug",
    "description": "The line map reader and the Monolog and Sentry integrations that point production errors at the .phn source positions of code written in Phaenon: opt-in, never called by compiled code",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "phaenon",
        "debug",
        "line map",
        "source map",
        "stack trace",
        "monolog",
        "sentry"
    ],
    "homepage": "https://phaenon.dev",
    "support": {
        "issues": "https://github.com/phaenonlang/debug/issues",
        "source": "https://github.com/phaenonlang/debug",
        "docs": "https://phaenon.dev"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "monolog/monolog": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "sentry/sentry": "^4.0"
    },
    "suggest": {
        "monolog/monolog": "^3.0: Phaenon\\Debug\\Monolog\\LineMapProcessor writes .phn source positions of logged exceptions",
        "sentry/sentry": "^4.0: Phaenon\\Debug\\Sentry\\LineMapIntegration sends .phn source positions and context lines to Sentry"
    },
    "autoload": {
        "psr-4": {
            "Phaenon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phaenon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    },
    "minimum-stability": "stable"
}
