parameters:
    level: max
    paths:
        - src
        - tests
    ignoreErrors:
        # The tests exercise check() on values whose type is known to the test.
        -
            identifier: method.alreadyNarrowedType
            path: tests/*
        -
            identifier: method.impossibleType
            path: tests/*
        # The same for the static assertions: Seq::first([]) is null by its signature, and the
        # test says so on purpose.
        -
            identifier: staticMethod.alreadyNarrowedType
            path: tests/*
